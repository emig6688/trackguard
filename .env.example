DATABASE_URL="postgresql://usuario:password@localhost:5432/flota_frigorifico"
# En producción con Supabase (u otro Postgres detrás de un connection pooler):
# DATABASE_URL = connection string POOLEADA (puerto 6543, "Transaction pooler" en Supabase, con ?pgbouncer=true) — la usa la app en runtime.
# DIRECT_URL   = connection string DIRECTA (puerto 5432) — la usa el CLI de Prisma para migrate/generate. Sin esto, "prisma migrate deploy" contra un pooler en modo transacción falla.
# DIRECT_URL="postgresql://usuario:password@host:5432/postgres"

AUTH_SECRET="generar-con-npx-auth-secret"

CRON_SECRET="generar-un-valor-random" # requerido: sin esto los 5 endpoints /api/cron/* devuelven 401 siempre

# RESEND_API_KEY="" # sin esto, lib/email.ts solo deja constancia en el log (no manda nada de verdad)
# RESEND_FROM_EMAIL="TruckGuard <notificaciones@tudominio.com>" # el dominio de "tudominio.com" tiene que
#   estar verificado en el dashboard de Resend (DNS: SPF/DKIM) — NO puede ser una casilla de Office 365
#   ajena a Resend. Sin verificar el dominio, o sin esta variable, Resend usa su remitente de pruebas
#   (onboarding@resend.dev), que solo entrega a la cuenta dueña de la API key, no a los destinatarios reales.

# BLOB_READ_WRITE_TOKEN="" # requerido para subir archivos (fotos de ticket, documentos) via Vercel Blob

# OPENAI_API_KEY="" # sin esto, la carga de combustible no lee el ticket con IA — el chofer completa
#   monto/litros/proveedor a mano, como siempre (lib/ocr-ticket-combustible.ts)

# VAPID_PUBLIC_KEY=""  # generar una sola vez con: node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_PRIVATE_KEY="" # sin las 3, el botón de "Activar notificaciones push" no hace nada (enviarPush() es un no-op)
# VAPID_SUBJECT="mailto:alertas@tudominio.com"

# NEXT_PUBLIC_SENTRY_DSN="" # sin esto, Sentry.init() queda inerte (no manda nada) — client, server y edge
#   comparten esta misma variable (el DSN no es secreto, es seguro que viaje al bundle del browser).
# SENTRY_ORG="tu-org-slug"       # solo hace falta para que next build suba source maps a Sentry
# SENTRY_PROJECT="tu-project-slug"
# SENTRY_AUTH_TOKEN=""           # token con scope project:releases — sin esto, next build salta la subida
#   de source maps (con un aviso) pero sigue compilando normal; Sentry igual recibe los errores vía DSN.
