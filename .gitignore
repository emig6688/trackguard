# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/e2e/.fixture.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example es la plantilla sin secretos, sí se versiona
# (DEPLOY.md la usa como referencia; sin esto un clone nuevo no la tiene)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# archivos subidos en desarrollo (storage local, ver lib/storage.ts)
/storage/uploads

# backups descargados con scripts/descargar-backup.ts (ver DEPLOY.md)
/*.json.gz
